  "oferta": {"tipo": "dialogo", "lineas": [["{jefe}", "Estoy viejo y tú no me has fallado nunca."], ["{jefe}", "Barrachina viene a por todo. Échalo de la ciudad y esta silla es tuya."]], "sig": "oDecide"},
