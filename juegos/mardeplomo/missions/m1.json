  "tuto1": {"tipo": "mensaje", "texto": "WASD para moverte, ratón para mirar. Ve al coche azul y pulsa E.", "sig": "subir"},
  "subir": {"tipo": "ir", "objetivo": "Sube al coche", "punto": [12, 204.6], "radio": 8, "enCoche": true, "sig": "tuto2"},
  "tuto2": {"tipo": "mensaje", "texto": "W acelera, S frena, A/D giran, Espacio es el freno de mano.", "sig": "barrio"},
