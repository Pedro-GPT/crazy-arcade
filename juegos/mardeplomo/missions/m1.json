{
 "id": "m1", "titulo": "El primer encargo", "inicio": "intro",
 "pasos": {
  "intro": {"tipo": "dialogo", "lineas": [["{jefe}", "Siéntate. Me han dicho que conduces y que no haces preguntas."], ["Tú", "Depende de lo que paguen."], ["{jefe}", "Este paquete va al bar La Marea, en la Salina. Entero y sin ruido."]], "sig": "coche"},
