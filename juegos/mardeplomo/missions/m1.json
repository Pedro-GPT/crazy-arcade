  "decide": {"tipo": "decision", "texto": "El policía señala el paquete.", "segundos": 10, "opciones": [
    {"id": "calma", "texto": "Hablar con calma: es un encargo para el bar", "resumen": "Mantuviste la calma con el policía de paisano", "efectos": {"marca": "m1_calma"}, "sig": "calma"},
    {"id": "soborno", "texto": "Ofrecerle 100 €", "resumen": "Intentaste sobornar al policía", "sig": "soborno"},
