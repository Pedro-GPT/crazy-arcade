  "calma": {"tipo": "dialogo", "lugar": "calle", "con": "maton1", "lineas": [["Tú", "Copas para La Marea. Pregunte al dueño, si quiere."], ["Policía de paisano", "Venga, circula. Te tengo visto."]], "sig": "entrega"},
  "soborno": {"tipo": "si", "cond": {"dineroMin": 100}, "sig": "sobornoSi", "sino": "sobornoNo"},
  "sobornoSi": {"tipo": "dialogo", "lugar": "calle", "con": "maton1", "efectos": {"dinero": -100, "marca": "soborno"}, "lineas": [["Policía de paisano", "Yo no he visto nada. Y tú a mí tampoco."]], "sig": "entrega"},
  "sobornoNo": {"tipo": "dialogo", "lugar": "calle", "con": "maton1", "lineas": [["Policía de paisano", "¿Con qué dinero, si no tienes? Estás detenido."]], "sig": "huir"},
