  "tuto3": {"tipo": "mensaje", "texto": "Una patrulla busca tu coche. Aléjate sin que te vean, o baja y escóndete en un contenedor verde (E).", "dur": 10, "sig": "perder"},
  "perder": {"tipo": "perder", "objetivo": "Escóndete de la patrulla", "sig": "cerca"},
  "cerca": {"tipo": "ir", "objetivo": "Lleva el paquete hacia el bar La Marea", "punto": [-160, 121], "radio": 14, "aPie": true, "sig": "parada"},
